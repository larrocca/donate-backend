SPRING_PROFILES_ACTIVE=local
PORT=8080

# Railway (perfil prod) — se activa solo si MYSQLHOST o RAILWAY_ENVIRONMENT están presentes.
# También podés forzar: SPRING_PROFILES_ACTIVE=prod
# MYSQLHOST=
# MYSQLPORT=
# MYSQLDATABASE=
# MYSQLUSER=
# MYSQLPASSWORD=

# Auth0 (opcional — application.properties trae defaults)
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_AUDIENCE=

# Obligatorio en Railway para búsqueda de ubicaciones (Nominatim bloquea @example.com)
# NOMINATIM_CONTACT_EMAIL=
